# Copy to .env (gitignored) or export in your shell before running the API/e2e tests.
# Never commit real values.

# JWT signing key: at least 32 random bytes, base64 or hex. No default is allowed.
JWT_KEY=

# SQL Server connection string used by AddDbContext.
ConnectionStrings__ContactDb=

# HMAC secret for anonymous digest action links. No default is allowed.
DIGEST_SECRET=

# E2E test configuration (required by Playwright setup; no hardcoded credentials).
E2E_API_URL=http://127.0.0.1:5156
E2E_EMAIL=
E2E_PASSWORD=
